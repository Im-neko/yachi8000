{
  "name": "yachi8000-agent",
  "version": "0.1.0",
  "description": "yachi8000 personal AI assistant agent (Flue / TypeScript)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-layering.mjs",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@earendil-works/pi-ai": "^0.83.0",
    "@flue/cli": "2.0.3",
    "@flue/runtime": "2.0.3",
    "@flue/vite": "2.0.3",
    "@hono/node-server": "2.1.1",
    "@noble/ciphers": "2.4.0",
    "discord.js": "14.27.0",
    "hono": "4.13.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "valibot": "1.5.0",
    "vite": "8.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
