PORT=3000
ENVIRONMENT=development
# true にすると /debug/chat（認証なし）が生える。ENVIRONMENT=production とは併用できない。
DEBUG_MODE=false

# LLM プロキシ（LiteLLM）の OpenAI 互換エンドポイント。/v1 まで含める。
LLM_PROXY_BASE_URL=http://localhost:4000/v1
LLM_PROXY_API_KEY=
# LLM プロキシの model_list[].model_name。起動時に実在とツール対応を検証する。
LLM_MODEL=<model_list の model_name>

# 文字起こし（F-13）。mode: audio_transcription のモデル名。
# 任意 —— 未設定なら音声入力の入口が 503 を返すだけで、会話は普通に動く。
STT_MODEL=<model_list の model_name（音声認識）>

DISCORD_BOT_TOKEN=

# 音声合成エンジン（VOICEVOX 互換 API）。別 Deployment で動かし、接続情報だけを渡す。
# 話者 ID・話速・音高は settings.yaml 側（ユーザー体験の定義なので環境変数には置かない）。
VOICEVOX_URL=http://localhost:50021

# 通知 API（POST /api/v1/notify）のトークン。"送信元:トークン" をカンマ区切りで並べる。
# 送信元はトークンから決まる。リクエスト本文に名乗らせない。
# 生成例: openssl rand -hex 32
NOTIFY_TOKENS=claude-code:CHANGE_ME

# Web 検索（F-35）の Brave Search API キー。
# https://api-dashboard.search.brave.com/ で発行する（Free プランで 1 本）。
# **必須。** 検索できないまま起動すると「調べて」に黙って答えられなくなる（→ D-27）。
BRAVE_SEARCH_API_KEY=

# 表情の判断（F-24）を頼む先。Jev（TypeSafe System One）の API キー。
# https://typesafe.ai/ で発行する。
# **任意。** 無ければアバターは素の顔のまま動く（起動時に WARN が 1 行出る）。
JEV_API_KEY=

# 長期記憶（pgvector）。会話履歴の SQLite とは別物。
MEMORY_DATABASE_URL=postgres://yachi8000:yachi8000@localhost:5432/yachi8000

# Flue の会話履歴 SQLite。k8s では PVC 上のパスを渡す。
FLUE_DB_PATH=./data/flue.db
# ランタイム状態（リマインダー・スキル・人格差分）の SQLite。
# **Flue の会話履歴 DB とは別ファイルにする**（→ D-24）。k8s では
# FLUE_DB_PATH と同じ PVC 上を指すこと。渡し忘れると Pod 再起動ごとに消える。
APP_DB_PATH=./data/yachi.db
# 静的設定（名前・人格・口調）。settings.example.yaml を複製して使う。
SETTINGS_PATH=./data/settings.yaml
